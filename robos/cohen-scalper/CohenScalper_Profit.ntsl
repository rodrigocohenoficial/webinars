// CohenScalper v1.19c - NTSL (Profit) - mesma regra do robo do MT5
// Rodar em grafico de 1 MINUTO do WIN. O robo monta os candles de 5 minutos.
// Sinal: candle de 5 min com corpo > 50%, fechando acima da maxima (compra)
// ou abaixo da minima (venda) do candle anterior, tamanho ate TamanhoMax.
// Entrada: espera recuar RecuoPct% do candle sinal e entra quando volta a abertura.
// Stop alem do candle sinal, parcial em Parcial pts com stop no 0x0, alvo final Alvo pts.
// Reentrada: saiu no 0x0 e o preco voltou a entrada em ate ReentradaMin minutos.
// Meta e loss do dia em pontos pelo preco medio (40 + 180 = 110).
input
  TempoSinal(5);
  CorpoMinPct(50);
  TamanhoMax(1000);
  TamanhoMin(0);
  ModoRetorno(1);
  RecuoPct(10);
  FolgaTicks(1);
  Parcial(40);
  ParcialPct(50);
  ZeroAposParcial(1);
  Alvo(180);
  Contratos(2);
  Inicio(915);
  UltimaEntrada(1500);
  Zerar(1730);
  MetaDia(1500);
  LossDia(500);
  MaxReentradas(1);
  ReentradaMin(5);
  DerrapagemTicks(20);

var
  passoPreco : Float;
  hh : Float;
  mm : Float;
  minutoDia : Float;
  resto : Float;
  bucketId : Float;
  bucketAtual : Float;
  ultimaData : Float;
  inicioMin : Float;
  ultimaMin : Float;
  zerarMin : Float;
  cO : Float;
  cH : Float;
  cL : Float;
  cC : Float;
  aH : Float;
  aL : Float;
  temCandle : Integer;
  temAnterior : Integer;
  fimCandle : Integer;
  tamanho : Float;
  corpo : Float;
  sinalDir : Integer;
  armado : Integer;
  barrasArmado : Integer;
  precoEntrada : Float;
  stopPlan : Float;
  recuo : Float;
  recuou : Integer;
  posAberta : Integer;
  parcialFeita : Integer;
  saiuZerando : Integer;
  dirPos : Integer;
  entrada : Float;
  stopIni : Float;
  stopAtual : Float;
  qtdIni : Float;
  qtdAnt : Float;
  qtdAgora : Float;
  qtdParcial : Float;
  saida : Float;
  pts : Float;
  ptsDia : Float;
  reRest : Integer;
  reDir : Integer;
  rePreco : Float;
  reStop : Float;
  reBarras : Integer;
  limiteDia : Integer;

begin
  passoPreco := MinPriceIncrement;
  qtdParcial := Floor(Contratos * ParcialPct / 100);

  hh := Floor(Time / 100);
  mm := Time - hh * 100;
  minutoDia := hh * 60 + mm;
  inicioMin := Floor(Inicio / 100) * 60 + (Inicio - Floor(Inicio / 100) * 100);
  ultimaMin := Floor(UltimaEntrada / 100) * 60 + (UltimaEntrada - Floor(UltimaEntrada / 100) * 100);
  zerarMin := Floor(Zerar / 100) * 60 + (Zerar - Floor(Zerar / 100) * 100);

  // Novo dia: zera tudo
  if (Date <> ultimaData) then
  begin
    ultimaData := Date;
    ptsDia := 0;
    temCandle := 0;
    temAnterior := 0;
    armado := 0;
    reDir := 0;
    bucketAtual := -1;
  end;

  limiteDia := 0;
  if (MetaDia > 0) and (ptsDia >= MetaDia) then
    limiteDia := 1;
  if (LossDia > 0) and (ptsDia <= (0 - LossDia)) then
    limiteDia := 1;

  // Posicao aberta
  if (Position <> 0) then
  begin
    qtdAgora := Abs(Position);

    if (posAberta = 0) then
    begin
      posAberta := 1;
      parcialFeita := 0;
      saiuZerando := 0;
      if (Position > 0) then
      begin
        dirPos := 1;
        entrada := BuyPrice;
      end
      else
      begin
        dirPos := -1;
        entrada := SellPrice;
      end;
      qtdIni := qtdAgora;
      qtdAnt := qtdAgora;
      stopIni := stopPlan;
      if (reDir <> 0) then
        reRest := reRest - 1;
      armado := 0;
      reDir := 0;
    end;

    // Saiu parte da posicao: foi a parcial
    if (qtdAgora < qtdAnt) and (parcialFeita = 0) then
    begin
      parcialFeita := 1;
      ptsDia := ptsDia + Parcial * (qtdAnt - qtdAgora) / qtdIni;
    end;
    qtdAnt := qtdAgora;

    if (parcialFeita = 1) and (ZeroAposParcial = 1) then
      stopAtual := entrada
    else
      stopAtual := stopIni;

    if (minutoDia >= zerarMin) then
    begin
      saiuZerando := 1;
      ClosePosition;
    end
    else
    begin
      if (dirPos = 1) then
      begin
        if (parcialFeita = 0) and (Parcial > 0) and (qtdParcial > 0) then
          SellToCoverLimit(entrada + Parcial, qtdParcial)
        else
          SellToCoverLimit(entrada + Alvo, qtdAgora);
        SellToCoverStop(stopAtual, stopAtual - DerrapagemTicks * passoPreco, qtdAgora);
      end
      else
      begin
        if (parcialFeita = 0) and (Parcial > 0) and (qtdParcial > 0) then
          BuyToCoverLimit(entrada - Parcial, qtdParcial)
        else
          BuyToCoverLimit(entrada - Alvo, qtdAgora);
        BuyToCoverStop(stopAtual, stopAtual + DerrapagemTicks * passoPreco, qtdAgora);
      end;
    end;
  end
  else
  begin
    // Posicao acabou de fechar
    if (posAberta = 1) then
    begin
      posAberta := 0;
      if (saiuZerando = 1) then
        saida := Close
      else
      begin
        if (parcialFeita = 1) then
        begin
          saida := stopAtual;
          if (dirPos = 1) and (High >= entrada + Alvo) then
            saida := entrada + Alvo;
          if (dirPos = -1) and (Low <= entrada - Alvo) then
            saida := entrada - Alvo;
        end
        else
          saida := stopIni;
      end;

      pts := (saida - entrada) * dirPos * qtdAnt / qtdIni;
      ptsDia := ptsDia + pts;
      if (MetaDia > 0) and (ptsDia >= MetaDia) then
        limiteDia := 1;
      if (LossDia > 0) and (ptsDia <= (0 - LossDia)) then
        limiteDia := 1;

      // Saiu no 0x0: arma a reentrada no preco da entrada
      if (parcialFeita = 1) and (ZeroAposParcial = 1) and (saida = entrada) and (reRest > 0) and (saiuZerando = 0) then
      begin
        reDir := dirPos;
        rePreco := entrada;
        reStop := stopIni;
        reBarras := 0;
      end;
    end;
  end;

  // Reentrada depois do 0x0
  if (Position = 0) and (reDir <> 0) then
  begin
    reBarras := reBarras + 1;
    if (reBarras > ReentradaMin) or (limiteDia = 1) or (minutoDia > ultimaMin) then
      reDir := 0;
    if (reDir = 1) and (Low <= reStop) then
      reDir := 0;
    if (reDir = -1) and (High >= reStop) then
      reDir := 0;
  end;

  // Entrada no retorno: acompanha o candle de entrada
  if (Position = 0) and (armado <> 0) then
  begin
    barrasArmado := barrasArmado + 1;
    if (barrasArmado = 1) then
      precoEntrada := Open;

    if ((armado = 1) and (Low <= stopPlan)) or ((armado = -1) and (High >= stopPlan)) then
      armado := 0
    else
    begin
      if (recuou = 0) then
      begin
        if (armado = 1) and (Low <= precoEntrada - recuo) then
          recuou := 1;
        if (armado = -1) and (High >= precoEntrada + recuo) then
          recuou := 1;
      end;
      if (barrasArmado >= TempoSinal) then
        armado := 0;
    end;
  end;

  // Monta o candle de 5 minutos
  resto := minutoDia - Floor(minutoDia / TempoSinal) * TempoSinal;
  bucketId := minutoDia - resto;
  if (bucketId <> bucketAtual) then
  begin
    bucketAtual := bucketId;
    cO := Open;
    cH := High;
    cL := Low;
    temCandle := 1;
  end
  else
  begin
    if (High > cH) then
      cH := High;
    if (Low < cL) then
      cL := Low;
  end;
  cC := Close;
  fimCandle := 0;
  if (temCandle = 1) and (resto = TempoSinal - 1) then
    fimCandle := 1;

  // Candle de 5 fechou: confere o sinal
  if (fimCandle = 1) then
  begin
    sinalDir := 0;
    tamanho := cH - cL;
    corpo := Abs(cC - cO);
    if (temAnterior = 1) and (tamanho > 0) and ((TamanhoMax <= 0) or (tamanho <= TamanhoMax)) and ((TamanhoMin <= 0) or (tamanho >= TamanhoMin)) and (corpo * 100 > CorpoMinPct * tamanho) then
    begin
      if (cC > cO) and (cC > aH) then
        sinalDir := 1;
      if (cC < cO) and (cC < aL) then
        sinalDir := -1;
    end;

    // O candle de entrada comeca no minuto seguinte
    if (sinalDir <> 0) and (Position = 0) and (limiteDia = 0) and (minutoDia + 1 >= inicioMin) and (minutoDia + 1 <= ultimaMin) and (minutoDia + 1 < zerarMin) then
    begin
      reDir := 0;
      reRest := MaxReentradas;
      precoEntrada := cC;
      recuo := tamanho * RecuoPct / 100;
      recuou := 0;
      barrasArmado := 0;
      if (sinalDir = 1) then
        stopPlan := cL - FolgaTicks * passoPreco
      else
        stopPlan := cH + FolgaTicks * passoPreco;

      if (ModoRetorno = 1) then
        armado := sinalDir
      else
      begin
        armado := 0;
        if (sinalDir = 1) then
          BuyAtMarket(Contratos)
        else
          SellShortAtMarket(Contratos);
      end;
    end;

    aH := cH;
    aL := cL;
    temAnterior := 1;
  end;

  // Ordens de entrada para a proxima barra
  if (Position = 0) and (limiteDia = 0) then
  begin
    if (armado <> 0) and (recuou = 1) then
    begin
      if (armado = 1) then
        BuyStop(precoEntrada, precoEntrada + DerrapagemTicks * passoPreco, Contratos)
      else
        SellShortStop(precoEntrada, precoEntrada - DerrapagemTicks * passoPreco, Contratos);
    end
    else
    begin
      if (reDir <> 0) then
      begin
        stopPlan := reStop;
        if (reDir = 1) then
          BuyLimit(rePreco, Contratos)
        else
          SellShortLimit(rePreco, Contratos);
      end;
    end;
  end;
end;
