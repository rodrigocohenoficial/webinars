// =====================================================================
// CohenScalper v1.26 - NTSL (Profit)  -  mesma regra do robô do MT5
//
// RODAR EM GRÁFICO DE 1 MINUTO do WIN, com execução TICK A TICK no
// backtest e na automação. O código é seguro para rodar a cada negócio:
//  - o candle de 5 min é montado com máxima/mínima/último negócio e só é
//    avaliado quando começa o candle seguinte (sem ler o histórico);
//  - o primeiro candle depois de ligar o robô é descartado (pode estar
//    pela metade);
//  - prazos (candle de entrada, reentrada) são por horário, não por
//    contagem de execuções;
//  - preços de parcial e saída = último negócio (Close) na execução em
//    que a posição mudou (o NTSL não informa o preço da ordem executada);
//  - recuo e perda do candle sinal pela mínima/máxima do minuto (o candle
//    de entrada começa junto com o minuto, então só conta preço depois de
//    armar; funciona também com a estratégia no gráfico, por candle);
//  - reentrada invalidada pela cotação atual (Close), como o MT5;
//  - candle sinal e anterior precisam ser do mesmo pregão, como o MT5;
//  - ordens pendentes: o Profit cancela a que não é reenviada; com
//    CancelarPendentes = 1 também chama CancelPendingOrders ao desarmar.
//
// Regra:
//  - Sinal: candle de 5 min com corpo > 50% do tamanho ou fechando na ponta
//    (martelo; Forca), fechando acima da
//    máxima (compra) ou abaixo da mínima (venda) do candle anterior,
//    tamanho até TamanhoMax.
//  - Entrada: espera o candle seguinte recuar RecuoPct% do candle sinal e
//    entra quando volta à abertura. Perdeu o candle sinal ou o candle
//    acabou sem voltar: não entra (a ordem deixa de ser enviada e o
//    Profit cancela).
//  - Stop: FolgaTicks além da mín/máx do candle sinal.
//  - Desde a entrada: metade com alvo na Parcial e metade no Alvo final.
//    Depois da parcial, stop no 0x0.
//  - Reentrada: saiu no 0x0 e o preço voltou à entrada em até
//    ReentradaMin minutos -> entra de novo (MaxReentradas vezes).
//  - Meta e loss do dia em pontos pelo preço médio (40 + 180 = 110).
//  - Posição que atravessar a noite é zerada no primeiro negócio do dia.
// =====================================================================
input
  TempoSinal(5);            // minutos do candle sinal
  Forca(2);                 // 0 = corpo > CorpoMinPct; 1 = fechou na ponta (martelo); 2 = qualquer um
  CorpoMinPct(50);          // corpo maior que X% do candle
  PontaPct(33);             // na ponta: no máximo X% do candle entre o fechamento e a máx (compra) / mín (venda)
  TamanhoMax(1000);         // tamanho máximo do candle sinal (pts, 0 = sem limite)
  TamanhoMin(0);            // tamanho mínimo do candle sinal (pts, 0 = sem filtro)
  ModoRetorno(1);           // 1 = espera recuar e voltar; 0 = a mercado na abertura
  RecuoPct(10);             // recuo mínimo, em % do candle sinal
  FolgaTicks(1);            // stop: ticks além da mín/máx do candle sinal
  Parcial(40);              // pts da parcial (0 = sem parcial)
  ParcialPct(50);           // % da posição na parcial
  ZeroAposParcial(1);       // 1 = stop no 0x0 depois da parcial
  Alvo(180);                // alvo final (pts)
  Contratos(2);             // sempre par
  HoraInicio(915);          // primeira entrada (HHMM)
  HoraUltimaEntrada(1500);  // última entrada (HHMM)
  HoraZerar(1730);          // zera posição (HHMM)
  MetaDia(1500);            // meta do dia (pts pelo preço médio, 0 = sem meta)
  LossDia(500);             // loss do dia (pts pelo preço médio, 0 = sem limite)
  MaxReentradas(0);         // reentradas por sinal depois do 0x0 (0 = desligado)
  ReentradaMin(5);          // minutos para o preço voltar à entrada
  DerrapagemTicks(20);      // limite das ordens stop (ticks além do gatilho)
  CancelarPendentes(0);     // 1 = chama CancelPendingOrders ao desarmar (teste na automação)

var
  passoPreco, minutoDia, inicioMin, ultimaMin, zerarMin, ultimaData : Float;
  bucketAgora, bucketAtual : Float;
  gO, gH, gL, gC, gData : Float;
  gCompleto : Boolean;
  cO, cH, cL, cC, aH, aL, cData, aData, tamanho, corpo, ateAPonta : Float;
  corpoOk, pontaOk, forcaOk : Boolean;
  temAnterior : Boolean;
  sinalDir, armado, bucketEntrada, precoEntrada, stopPlan, recuo : Float;
  recuou : Boolean;
  posAberta, parcialFeita, saiuZerando : Boolean;
  dirPos, entrada, dataEntrada, stopIni, stopAtual : Float;
  qtdIni, qtdAnt, qtdAgora, qtdParcial, qtdFinal : Float;
  saida, pts, ptsDia, alvoPreco, distAlvo, distStop : Float;
  reRest, reDir, rePreco, reStop, reAte : Float;
  limiteDia, enviou, pendente, foi0x0 : Boolean;

begin
  passoPreco := MinPriceIncrement;
  qtdParcial := Floor(Contratos * ParcialPct / 100);
  if (Parcial <= 0) then
    qtdParcial := 0;

  minutoDia := Floor(Time / 100) * 60 + (Time - Floor(Time / 100) * 100);
  inicioMin := Floor(HoraInicio / 100) * 60 + (HoraInicio - Floor(HoraInicio / 100) * 100);
  ultimaMin := Floor(HoraUltimaEntrada / 100) * 60 + (HoraUltimaEntrada - Floor(HoraUltimaEntrada / 100) * 100);
  zerarMin  := Floor(HoraZerar / 100) * 60 + (HoraZerar - Floor(HoraZerar / 100) * 100);

  // ---------------- Novo dia ----------------
  if (Date <> ultimaData) then
  begin
    ultimaData := Date;
    ptsDia := 0;
    armado := 0;
    reDir := 0;
  end;

  limiteDia := ((MetaDia > 0) and (ptsDia >= MetaDia)) or ((LossDia > 0) and (ptsDia <= -LossDia));

  // ---------------- Posição aberta ----------------
  if (Position <> 0) then
  begin
    qtdAgora := Abs(Position);

    if (not posAberta) then
    begin
      // Acabou de executar: guarda entrada, stop e dia.
      posAberta := true;
      parcialFeita := false;
      saiuZerando := false;
      if (Position > 0) then
      begin
        dirPos := 1;
        entrada := BuyPrice;
      end
      else
      begin
        dirPos := -1;
        entrada := SellPrice;
      end;
      dataEntrada := Date;
      qtdIni := qtdAgora;
      qtdAnt := qtdAgora;
      stopIni := stopPlan;
      if (reDir <> 0) then
        reRest := reRest - 1;
      armado := 0;
      reDir := 0;
    end;

    // Saiu parte da posição: foi a parcial. O stop e o alvo final cobrem a
    // posição inteira ou o resto dela, então só a parcial reduz sem zerar.
    if (qtdAgora < qtdAnt) and (not parcialFeita) then
    begin
      parcialFeita := true;
      ptsDia := ptsDia + (Close - entrada) * dirPos * (qtdAnt - qtdAgora) / qtdIni;
    end;
    qtdAnt := qtdAgora;

    if parcialFeita and (ZeroAposParcial = 1) then
      stopAtual := entrada
    else
      stopAtual := stopIni;

    if (minutoDia >= zerarMin) or (Date <> dataEntrada) then
    begin
      // Horário de zerar, ou posição que atravessou a noite.
      saiuZerando := true;
      ClosePosition;
    end
    else if (dirPos = 1) then
    begin
      if parcialFeita or (qtdParcial = 0) then
        SellToCoverLimit(entrada + Alvo, qtdAgora)
      else
      begin
        SellToCoverLimit(entrada + Parcial, qtdParcial);
        qtdFinal := qtdAgora - qtdParcial;
        if (qtdFinal > 0) then
          SellToCoverLimit(entrada + Alvo, qtdFinal);
      end;
      SellToCoverStop(stopAtual, stopAtual - DerrapagemTicks * passoPreco, qtdAgora);
    end
    else
    begin
      if parcialFeita or (qtdParcial = 0) then
        BuyToCoverLimit(entrada - Alvo, qtdAgora)
      else
      begin
        BuyToCoverLimit(entrada - Parcial, qtdParcial);
        qtdFinal := qtdAgora - qtdParcial;
        if (qtdFinal > 0) then
          BuyToCoverLimit(entrada - Alvo, qtdFinal);
      end;
      BuyToCoverStop(stopAtual, stopAtual + DerrapagemTicks * passoPreco, qtdAgora);
    end;
  end
  else if posAberta then  // ---------------- Posição acabou de fechar ----------------
  begin
    posAberta := false;

    // Preço de saída = último negócio na execução em que zerou.
    // Saída perto da entrada, depois da parcial, foi o 0x0 (e não o alvo).
    saida := Close;
    alvoPreco := entrada + dirPos * Alvo;
    distAlvo := Abs(saida - alvoPreco);
    distStop := Abs(saida - entrada);
    foi0x0 := parcialFeita and (ZeroAposParcial = 1) and (distStop < distAlvo) and (not saiuZerando);

    pts := (saida - entrada) * dirPos * qtdAnt / qtdIni;
    ptsDia := ptsDia + pts;
    limiteDia := ((MetaDia > 0) and (ptsDia >= MetaDia)) or ((LossDia > 0) and (ptsDia <= -LossDia));

    // Saiu no 0x0: arma a reentrada no preço da entrada, por ReentradaMin
    // minutos (o NTSL conta em minutos inteiros; o MT5, em segundos).
    if foi0x0 and (reRest > 0) then
    begin
      reDir := dirPos;
      rePreco := entrada;
      reStop := stopIni;
      reAte := minutoDia + ReentradaMin;
    end;
  end;

  // ---------------- Reentrada depois do 0x0 ----------------
  if (Position = 0) and (reDir <> 0) then
  begin
    if (minutoDia > reAte) or limiteDia or (minutoDia > ultimaMin) then
      reDir := 0
    else if ((reDir = 1) and (Close <= reStop)) or ((reDir = -1) and (Close >= reStop)) then
      reDir := 0;
  end;

  // ---------------- Candle de 5 minutos ----------------
  // gO/gH/gL/gC acumulam o candle em andamento (máxima, mínima e último
  // negócio). Quando começa o próximo candle, o acumulado é o candle fechado.
  bucketAgora := minutoDia - (minutoDia - Floor(minutoDia / TempoSinal) * TempoSinal);
  if (bucketAgora <> bucketAtual) then
  begin
    // O candle de entrada que estava armado acabou sem voltar: cancela.
    armado := 0;

    if gCompleto then
    begin
      cO := gO;
      cH := gH;
      cL := gL;
      cC := gC;
      cData := gData;
      sinalDir := 0;
      tamanho := cH - cL;
      corpo := Abs(cC - cO);
      // Força: corpo grande, ou fechamento colado na ponta a favor (martelo).
      corpoOk := (corpo * 100 > CorpoMinPct * tamanho);
      if (cC > cO) then
        ateAPonta := cH - cC
      else
        ateAPonta := cC - cL;
      pontaOk := (ateAPonta * 100 <= PontaPct * tamanho);
      if (Forca = 1) then
        forcaOk := pontaOk
      else if (Forca = 2) then
        forcaOk := corpoOk or pontaOk
      else
        forcaOk := corpoOk;
      // Candle sinal e anterior do mesmo pregão, e o de entrada também (como o MT5).
      if temAnterior and (aData = cData) and (cData = Date) and (tamanho > 0) and (cC <> cO) and
         ((TamanhoMax <= 0) or (tamanho <= TamanhoMax)) and
         ((TamanhoMin <= 0) or (tamanho >= TamanhoMin)) and forcaOk then
      begin
        if (cC > cO) and (cC > aH) then
          sinalDir := 1
        else if (cC < cO) and (cC < aL) then
          sinalDir := -1;
      end;

      // O candle de entrada é o que está começando agora.
      if (sinalDir <> 0) and (Position = 0) and (not limiteDia) and
         (bucketAgora >= inicioMin) and (bucketAgora <= ultimaMin) and (bucketAgora < zerarMin) then
      begin
        reDir := 0;
        reRest := MaxReentradas;
        bucketEntrada := bucketAgora;
        precoEntrada := Open;              // abertura do candle de entrada
        recuo := tamanho * RecuoPct / 100;
        recuou := false;
        if (sinalDir = 1) then
          stopPlan := cL - FolgaTicks * passoPreco
        else
          stopPlan := cH + FolgaTicks * passoPreco;

        if (ModoRetorno = 1) then
          armado := sinalDir
        else if (sinalDir = 1) then
          BuyAtMarket(Contratos)
        else
          SellShortAtMarket(Contratos);
      end;

      aH := cH;
      aL := cL;
      aData := cData;
      temAnterior := true;
    end;

    // Começa a acumular o candle novo. Só conta como completo se o robô viu
    // o candle desde o começo (o primeiro depois de ligar é descartado).
    gCompleto := (bucketAtual > 0);
    bucketAtual := bucketAgora;
    gO := Open;
    gH := High;
    gL := Low;
    gC := Close;
    gData := Date;
  end
  else
  begin
    if (High > gH) then gH := High;
    if (Low < gL) then gL := Low;
    gC := Close;
  end;

  // ---------------- Entrada no retorno: dentro do candle de entrada ----------------
  if (Position = 0) and (armado <> 0) then
  begin
    if (bucketAtual <> bucketEntrada) then
      armado := 0
    else if ((armado = 1) and (Low <= stopPlan)) or ((armado = -1) and (High >= stopPlan)) then
      armado := 0                     // perdeu o candle sinal antes de entrar
    else if (not recuou) then
    begin
      if ((armado = 1) and (Low <= precoEntrada - recuo)) or ((armado = -1) and (High >= precoEntrada + recuo)) then
        recuou := true;
    end;
  end;

  // ---------------- Ordens de entrada ----------------
  // A reentrada usa ordem limitada no preço da entrada: executa no mesmo preço
  // da ordem a mercado do MT5 e não duplica a ordem se a posição demorar a
  // aparecer na automação (uma ordem a mercado reenviada a cada negócio duplicaria).
  if (Position = 0) then
  begin
    enviou := false;
    if (not limiteDia) and (minutoDia < zerarMin) then
    begin
      if (armado <> 0) and recuou then
      begin
        if (armado = 1) then
          BuyStop(precoEntrada, precoEntrada + DerrapagemTicks * passoPreco, Contratos)
        else
          SellShortStop(precoEntrada, precoEntrada - DerrapagemTicks * passoPreco, Contratos);
        enviou := true;
      end
      else if (reDir <> 0) then
      begin
        stopPlan := reStop;
        if (reDir = 1) then
          BuyLimit(rePreco, Contratos)
        else
          SellShortLimit(rePreco, Contratos);
        enviou := true;
      end;
    end;

    // Desarmou (candle acabou, perdeu o sinal, prazo da reentrada) ou acabou de
    // zerar: cancela explicitamente o que ficou pendente.
    if enviou then
      pendente := true
    else if pendente then
    begin
      if (CancelarPendentes = 1) then
        CancelPendingOrders;
      pendente := false;
    end;
  end
  else
    pendente := true;
end;
