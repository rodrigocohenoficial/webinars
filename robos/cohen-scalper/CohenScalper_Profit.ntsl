// =====================================================================
// CohenScalper v1.20 - NTSL (Profit)  -  mesma regra do robô do MT5
//
// RODAR EM GRÁFICO DE 1 MINUTO do WIN, com execução TICK A TICK no
// backtest e na automação. O código é seguro para rodar a cada negócio:
//  - o candle de 5 min é lido do histórico (barras [1] a [5]) quando
//    começa o candle seguinte, não somado barra a barra;
//  - prazos (candle de entrada, reentrada) são por horário, não por
//    contagem de execuções;
//  - a saída é identificada pelo último negócio (Close), não pela
//    máxima/mínima do candle.
//
// Regra:
//  - Sinal: candle de 5 min com corpo > 50% do tamanho, fechando acima da
//    máxima (compra) ou abaixo da mínima (venda) do candle anterior,
//    tamanho até TamanhoMax.
//  - Entrada: espera o candle seguinte recuar RecuoPct% do candle sinal e
//    entra quando volta à abertura. Perdeu o candle sinal ou o candle
//    acabou sem voltar: não entra (a ordem deixa de ser enviada e o
//    Profit cancela).
//  - Stop: FolgaTicks além da mín/máx do candle sinal.
//  - Desde a entrada: metade com alvo na Parcial e metade no Alvo final.
//    Depois da parcial, stop no 0x0.
//  - Reentrada: saiu no 0x0 e o preço voltou à entrada em até
//    ReentradaMin minutos -> entra de novo (MaxReentradas vezes).
//  - Meta e loss do dia em pontos pelo preço médio (40 + 180 = 110).
//  - Posição que atravessar a noite é zerada no primeiro negócio do dia.
// =====================================================================
input
  TempoSinal(5);            // minutos do candle sinal
  CorpoMinPct(50);          // corpo maior que X% do candle
  TamanhoMax(1000);         // tamanho máximo do candle sinal (pts, 0 = sem limite)
  TamanhoMin(0);            // tamanho mínimo do candle sinal (pts, 0 = sem filtro)
  ModoRetorno(1);           // 1 = espera recuar e voltar; 0 = a mercado na abertura
  RecuoPct(10);             // recuo mínimo, em % do candle sinal
  FolgaTicks(1);            // stop: ticks além da mín/máx do candle sinal
  Parcial(40);              // pts da parcial (0 = sem parcial)
  ParcialPct(50);           // % da posição na parcial
  ZeroAposParcial(1);       // 1 = stop no 0x0 depois da parcial
  Alvo(180);                // alvo final (pts)
  Contratos(2);             // sempre par
  HoraInicio(915);          // primeira entrada (HHMM)
  HoraUltimaEntrada(1500);  // última entrada (HHMM)
  HoraZerar(1730);          // zera posição (HHMM)
  MetaDia(1500);            // meta do dia (pts pelo preço médio, 0 = sem meta)
  LossDia(500);             // loss do dia (pts pelo preço médio, 0 = sem limite)
  MaxReentradas(1);         // reentradas por sinal depois do 0x0 (0 = desligado)
  ReentradaMin(5);          // minutos para o preço voltar à entrada
  DerrapagemTicks(20);      // limite das ordens stop (ticks além do gatilho)

var
  passoPreco, minutoDia, inicioMin, ultimaMin, zerarMin, ultimaData : Float;
  bucketAgora, bucketAtual, bucketFechado, mk, achou : Float;
  k : Integer;
  cO, cH, cL, cC, aH, aL, tamanho, corpo : Float;
  temAnterior : Boolean;
  sinalDir, armado, bucketEntrada, precoEntrada, stopPlan, recuo : Float;
  recuou : Boolean;
  posAberta, parcialFeita, saiuZerando : Boolean;
  dirPos, entrada, dataEntrada, stopIni, stopAtual : Float;
  qtdIni, qtdAnt, qtdAgora, qtdParcial, qtdFinal : Float;
  saida, pts, ptsDia, alvoPreco, distAlvo, distStop : Float;
  reRest, reDir, rePreco, reStop, reAte : Float;
  limiteDia : Boolean;

begin
  passoPreco := MinPriceIncrement;
  qtdParcial := Floor(Contratos * ParcialPct / 100);
  if (Parcial <= 0) then
    qtdParcial := 0;

  minutoDia := Floor(Time / 100) * 60 + (Time - Floor(Time / 100) * 100);
  inicioMin := Floor(HoraInicio / 100) * 60 + (HoraInicio - Floor(HoraInicio / 100) * 100);
  ultimaMin := Floor(HoraUltimaEntrada / 100) * 60 + (HoraUltimaEntrada - Floor(HoraUltimaEntrada / 100) * 100);
  zerarMin  := Floor(HoraZerar / 100) * 60 + (HoraZerar - Floor(HoraZerar / 100) * 100);

  // ---------------- Novo dia ----------------
  if (Date <> ultimaData) then
  begin
    ultimaData := Date;
    ptsDia := 0;
    armado := 0;
    reDir := 0;
  end;

  limiteDia := ((MetaDia > 0) and (ptsDia >= MetaDia)) or ((LossDia > 0) and (ptsDia <= -LossDia));

  // ---------------- Posição aberta ----------------
  if (Position <> 0) then
  begin
    qtdAgora := Abs(Position);

    if (not posAberta) then
    begin
      // Acabou de executar: guarda entrada, stop e dia.
      posAberta := true;
      parcialFeita := false;
      saiuZerando := false;
      if (Position > 0) then
      begin
        dirPos := 1;
        entrada := BuyPrice;
      end
      else
      begin
        dirPos := -1;
        entrada := SellPrice;
      end;
      dataEntrada := Date;
      qtdIni := qtdAgora;
      qtdAnt := qtdAgora;
      stopIni := stopPlan;
      if (reDir <> 0) then
        reRest := reRest - 1;
      armado := 0;
      reDir := 0;
    end;

    // Saiu parte da posição: foi a parcial (ordem limitada em entrada + Parcial).
    if (qtdAgora < qtdAnt) and (not parcialFeita) then
    begin
      parcialFeita := true;
      ptsDia := ptsDia + Parcial * (qtdAnt - qtdAgora) / qtdIni;
    end;
    qtdAnt := qtdAgora;

    if parcialFeita and (ZeroAposParcial = 1) then
      stopAtual := entrada
    else
      stopAtual := stopIni;

    if (minutoDia >= zerarMin) or (Date <> dataEntrada) then
    begin
      // Horário de zerar, ou posição que atravessou a noite.
      saiuZerando := true;
      ClosePosition;
    end
    else if (dirPos = 1) then
    begin
      if parcialFeita or (qtdParcial = 0) then
        SellToCoverLimit(entrada + Alvo, qtdAgora)
      else
      begin
        SellToCoverLimit(entrada + Parcial, qtdParcial);
        qtdFinal := qtdAgora - qtdParcial;
        if (qtdFinal > 0) then
          SellToCoverLimit(entrada + Alvo, qtdFinal);
      end;
      SellToCoverStop(stopAtual, stopAtual - DerrapagemTicks * passoPreco, qtdAgora);
    end
    else
    begin
      if parcialFeita or (qtdParcial = 0) then
        BuyToCoverLimit(entrada - Alvo, qtdAgora)
      else
      begin
        BuyToCoverLimit(entrada - Parcial, qtdParcial);
        qtdFinal := qtdAgora - qtdParcial;
        if (qtdFinal > 0) then
          BuyToCoverLimit(entrada - Alvo, qtdFinal);
      end;
      BuyToCoverStop(stopAtual, stopAtual + DerrapagemTicks * passoPreco, qtdAgora);
    end;
  end
  else if posAberta then  // ---------------- Posição acabou de fechar ----------------
  begin
    posAberta := false;

    // Preço de saída: o último negócio (Close) diz qual ordem executou,
    // o alvo ou o stop, o que estiver mais perto dele.
    alvoPreco := entrada + dirPos * Alvo;
    distAlvo := Abs(Close - alvoPreco);
    distStop := Abs(Close - stopAtual);
    if saiuZerando then
      saida := Close
    else if (distAlvo < distStop) then
      saida := alvoPreco
    else
      saida := stopAtual;

    pts := (saida - entrada) * dirPos * qtdAnt / qtdIni;
    ptsDia := ptsDia + pts;
    limiteDia := ((MetaDia > 0) and (ptsDia >= MetaDia)) or ((LossDia > 0) and (ptsDia <= -LossDia));

    // Saiu no 0x0: arma a reentrada no preço da entrada, por ReentradaMin minutos.
    if parcialFeita and (ZeroAposParcial = 1) and (saida = entrada) and (reRest > 0) and (not saiuZerando) then
    begin
      reDir := dirPos;
      rePreco := entrada;
      reStop := stopIni;
      reAte := minutoDia + ReentradaMin;
    end;
  end;

  // ---------------- Reentrada depois do 0x0 ----------------
  if (Position = 0) and (reDir <> 0) then
  begin
    if (minutoDia > reAte) or limiteDia or (minutoDia > ultimaMin) then
      reDir := 0
    else if ((reDir = 1) and (Low <= reStop)) or ((reDir = -1) and (High >= reStop)) then
      reDir := 0;
  end;

  // ---------------- Começou um candle de 5: confere o que acabou de fechar ----------------
  bucketAgora := minutoDia - (minutoDia - Floor(minutoDia / TempoSinal) * TempoSinal);
  if (bucketAgora <> bucketAtual) then
  begin
    bucketFechado := bucketAtual;
    bucketAtual := bucketAgora;

    // O candle de entrada que estava armado acabou sem voltar: cancela.
    armado := 0;

    // Monta o candle fechado com as barras de 1 min [1]..[TempoSinal] do mesmo período.
    achou := 0;
    for k := 1 to TempoSinal do
    begin
      mk := Floor(Time[k] / 100) * 60 + (Time[k] - Floor(Time[k] / 100) * 100);
      if (mk - (mk - Floor(mk / TempoSinal) * TempoSinal) = bucketFechado) and (Date[k] = Date[1]) then
      begin
        if (achou = 0) then
        begin
          cH := High[k];
          cL := Low[k];
          cC := Close[k];
        end
        else
        begin
          if (High[k] > cH) then cH := High[k];
          if (Low[k] < cL) then cL := Low[k];
        end;
        cO := Open[k];
        achou := achou + 1;
      end;
    end;

    if (achou > 0) then
    begin
      sinalDir := 0;
      tamanho := cH - cL;
      corpo := Abs(cC - cO);
      if temAnterior and (tamanho > 0) and
         ((TamanhoMax <= 0) or (tamanho <= TamanhoMax)) and
         ((TamanhoMin <= 0) or (tamanho >= TamanhoMin)) and
         (corpo * 100 > CorpoMinPct * tamanho) then
      begin
        if (cC > cO) and (cC > aH) then
          sinalDir := 1
        else if (cC < cO) and (cC < aL) then
          sinalDir := -1;
      end;

      // O candle de entrada é o que está começando agora.
      if (sinalDir <> 0) and (Position = 0) and (not limiteDia) and
         (bucketAtual >= inicioMin) and (bucketAtual <= ultimaMin) and (bucketAtual < zerarMin) then
      begin
        reDir := 0;
        reRest := MaxReentradas;
        bucketEntrada := bucketAtual;
        precoEntrada := Open;              // abertura do candle de entrada
        recuo := tamanho * RecuoPct / 100;
        recuou := false;
        if (sinalDir = 1) then
          stopPlan := cL - FolgaTicks * passoPreco
        else
          stopPlan := cH + FolgaTicks * passoPreco;

        if (ModoRetorno = 1) then
          armado := sinalDir
        else if (sinalDir = 1) then
          BuyAtMarket(Contratos)
        else
          SellShortAtMarket(Contratos);
      end;

      aH := cH;
      aL := cL;
      temAnterior := true;
    end;
  end;

  // ---------------- Entrada no retorno: dentro do candle de entrada ----------------
  if (Position = 0) and (armado <> 0) then
  begin
    if (bucketAtual <> bucketEntrada) then
      armado := 0
    else if ((armado = 1) and (Low <= stopPlan)) or ((armado = -1) and (High >= stopPlan)) then
      armado := 0                     // perdeu o candle sinal antes de entrar
    else if (not recuou) then
    begin
      if ((armado = 1) and (Low <= precoEntrada - recuo)) or ((armado = -1) and (High >= precoEntrada + recuo)) then
        recuou := true;
    end;
  end;

  // ---------------- Ordens de entrada ----------------
  // No NTSL a ordem vale até a próxima execução: se não for reenviada, o Profit cancela.
  if (Position = 0) and (not limiteDia) and (minutoDia < zerarMin) then
  begin
    if (armado <> 0) and recuou then
    begin
      if (armado = 1) then
        BuyStop(precoEntrada, precoEntrada + DerrapagemTicks * passoPreco, Contratos)
      else
        SellShortStop(precoEntrada, precoEntrada - DerrapagemTicks * passoPreco, Contratos);
    end
    else if (reDir <> 0) then
    begin
      stopPlan := reStop;
      if (reDir = 1) then
        BuyLimit(rePreco, Contratos)
      else
        SellShortLimit(rePreco, Contratos);
    end;
  end;
end;
